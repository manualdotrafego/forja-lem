---
// Layout dedicado da landing FORJA LEM.
// Fica fora do PageLayout do AstroWind de proposito: a pagina tem identidade
// propria (preto + dourado + brasa), sem header, footer ou toggle de tema do template.
import '~/assets/styles/tailwind.css';
import { Font } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;

// Pixel da Meta. O ID e publico por natureza: ele aparece no HTML de qualquer
// site que rode o pixel. O token da API de Conversoes NAO entra aqui, nem em
// lugar nenhum deste repositorio, porque o site e estatico e publico.
const PIXEL_META = '1279060486021727';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;

// Imagem de compartilhamento (WhatsApp, Facebook, LinkedIn) precisa de URL absoluta.
const ogImage = image && Astro.site ? new URL(image, Astro.site).toString() : image;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0908" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- ==================== PIXEL DA META ====================
         Carrega so em producao: em localhost os testes sujariam os dados
         da conta de anuncios. -->
    <script is:inline define:vars={{ PIXEL_META }}>
      if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
        /* eslint-disable */
        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = !0;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        /* eslint-enable */

        fbq('init', PIXEL_META);
        fbq('track', 'PageView');
      }
    </script>

    <script is:inline>
      // roda antes do primeiro paint: evita o flash do conteudo que sera animado.
      // Nao tem prazo aqui de proposito: a classe precisa durar a sessao toda,
      // porque e ela que sustenta o estado escondido das revelacoes. Quem
      // desfaz em caso de falha e o vigia em src/scripts/forja-movimento.ts.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
      }
    </script>

    <Font cssVariable="--font-garamond" preload />
    <Font cssVariable="--font-montserrat" preload />
    <Font cssVariable="--font-inter" />

    <style is:global>
      :root {
        --forja-preto: #0a0908;
        --forja-carvao: #131110;
        --forja-fumaca: #1c1917;
        --forja-ouro: #ebc173;
        --forja-ouro-claro: #f4e1c8;
        --forja-creme: #fff1df;
        --forja-brasa: #d9662b;

        --font-display: var(--font-garamond), Georgia, serif;
        --font-label: var(--font-montserrat), sans-serif;
        --font-body: var(--font-inter), system-ui, sans-serif;
      }

      html {
        background-color: var(--forja-preto);
      }

      body {
        background-color: var(--forja-preto);
        color: var(--forja-creme);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
      }

      ::selection {
        background: var(--forja-ouro);
        color: var(--forja-preto);
      }

      .font-display {
        font-family: var(--font-display);
      }
      .font-label {
        font-family: var(--font-label);
      }

      .rotulo {
        font-family: var(--font-label);
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }

      /* Emenda entre secoes: em vez de linha dura, um veu que dissolve a
         borda de uma na outra e deixa as fagulhas passarem por tras */
      .emenda::before,
      .emenda::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        height: 5rem;
        pointer-events: none;
      }
      .emenda::before {
        top: 0;
        background: linear-gradient(to bottom, rgba(10, 9, 8, 0.9), transparent);
      }
      .emenda::after {
        bottom: 0;
        background: linear-gradient(to top, rgba(10, 9, 8, 0.9), transparent);
      }

      /* ---------- Carrossel de patrocinadores ----------
         Marquee em CSS puro: dois grupos identicos lado a lado e um
         translateX de -50%, que fecha o laco sem emenda. Sem JavaScript
         de proposito, para nao depender de requestAnimationFrame. */
      .carrossel {
        -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
        mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
      }

      .carrossel-faixa {
        display: flex;
        width: max-content;
        animation: desliza 42s linear infinite;
      }

      .carrossel:hover .carrossel-faixa,
      .carrossel:focus-within .carrossel-faixa {
        animation-play-state: paused;
      }

      @keyframes desliza {
        to {
          transform: translateX(-50%);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        /* vira uma grade parada, sem movimento nenhum */
        .carrossel {
          -webkit-mask-image: none;
          mask-image: none;
        }
        .carrossel-faixa {
          animation: none;
          width: auto;
          flex-wrap: wrap;
          justify-content: center;
        }
        .carrossel-copia {
          display: none;
        }
      }

      /* Filete dourado usado como separador entre secoes */
      .filete {
        background: linear-gradient(90deg, transparent, rgba(235, 193, 115, 0.45), transparent);
        height: 1px;
      }

      /* Revelacoes.
         Quem esconde e o CSS, preso a .js-motion no <html>. O JS so poe a
         classe .revelado no gatilho. Se o GSAP quebrar ou o rAF nao rodar,
         tirar .js-motion mostra a pagina inteira de uma vez, e e o que o
         vigia do forja-movimento.ts faz. */
      /* Esconde por opacity, nao por visibility. Com visibility, assim que o
         GSAP terminava o tween e soltava a propriedade, esta regra voltava a
         valer e o hero sumia de novo. Com opacity, o valor inline que o tween
         deixa (opacity:1) continua ganhando da folha de estilo. */
      .js-motion [data-hero-rotulo],
      .js-motion [data-hero-linha],
      .js-motion [data-hero-item] {
        opacity: 0;
      }

      [data-revelar],
      [data-revelar-lista] > * {
        transition:
          opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
          transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .js-motion [data-revelar],
      .js-motion [data-revelar-lista] > * {
        opacity: 0;
        transform: translateY(2rem);
      }

      .js-motion [data-revelar].revelado,
      .js-motion [data-revelar-lista].revelado > * {
        opacity: 1;
        transform: none;
      }

      /* Escalonamento em CSS puro: nao depende de requestAnimationFrame */
      .js-motion [data-revelar-lista] > *:nth-child(1) {
        transition-delay: 0s;
      }
      .js-motion [data-revelar-lista] > *:nth-child(2) {
        transition-delay: 0.07s;
      }
      .js-motion [data-revelar-lista] > *:nth-child(3) {
        transition-delay: 0.14s;
      }
      .js-motion [data-revelar-lista] > *:nth-child(4) {
        transition-delay: 0.21s;
      }
      .js-motion [data-revelar-lista] > *:nth-child(5) {
        transition-delay: 0.28s;
      }
      .js-motion [data-revelar-lista] > *:nth-child(n + 6) {
        transition-delay: 0.35s;
      }

      @media (max-width: 1023px) {
        .js-motion [data-revelar],
        .js-motion [data-revelar-lista] > * {
          transform: translateY(1.25rem);
        }
      }

      /* O Lenis controla a rolagem no desktop, entao o smooth nativo sai de cena */
      html.lenis,
      html.lenis body {
        height: auto;
      }
      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </head>

  <body>
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        alt=""
        src={`https://www.facebook.com/tr?id=${PIXEL_META}&ev=PageView&noscript=1`}
      /></noscript
    >

    <slot />

    <script>
      import { iniciar } from '~/scripts/forja-movimento';
      iniciar();
    </script>

    <script>
      import { ligarEventosPixel } from '~/scripts/forja-pixel';
      ligarEventosPixel();
    </script>
  </body>
</html>
